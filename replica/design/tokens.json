{
  "_about": "Tokens extraidos de index.html (tema escuro = padrao). Tema claro em tokens.light.json. Valores em px (1rem = 16px).",
  "color": {
    "bg": "#17120f",
    "surface": "#231a15",
    "border": "#4a3a2f",
    "text": "#f3e6d0",
    "text-muted": "#b9a58f",
    "accent": "#ff6a2b",
    "on-accent": "#1a0d06"
  },
  "pairs": [
    ["text", "bg"],
    ["text", "surface"],
    ["text-muted", "bg"],
    ["text-muted", "surface"],
    ["on-accent", "accent"],
    ["accent", "bg", "large"],
    ["accent", "bg"]
  ],
  "font": {
    "display": "\"Big Shoulders Display\", \"Arial Narrow\", Impact, sans-serif",
    "body": "\"Hanken Grotesk\", system-ui, -apple-system, \"Segoe UI\", sans-serif"
  },
  "type": {
    "tag":     {"size": 11,  "line": 17, "weight": 700, "font": "body", "tracking": ".1em"},
    "eyebrow": {"size": 13,  "line": 21, "weight": 400, "font": "body", "tracking": ".18em", "case": "upper"},
    "sm":      {"size": 14,  "line": 22, "weight": 400, "font": "body"},
    "item":    {"size": 16,  "line": 25, "weight": 400, "font": "body"},
    "base":    {"size": 17,  "line": 27, "weight": 400, "font": "body"},
    "lead":    {"size": 19,  "line": 30, "weight": 400, "font": "body"},
    "cta":     {"size": 19,  "line": 24, "weight": 700, "font": "body"},
    "price":   {"size": 22,  "line": 24, "weight": 700, "font": "display"},
    "h3":      {"size": 27,  "line": 26, "weight": 700, "font": "display", "tracking": ".02em", "case": "upper"},
    "h2":      {"size": "clamp(41px, 8vw, 72px)", "line": ".95", "weight": 900, "font": "display", "case": "upper"},
    "h2-sm":   {"size": "clamp(32px, 6vw, 48px)", "line": ".95", "weight": 900, "font": "display", "case": "upper"},
    "h1":      {"size": "clamp(64px, 15vw, 144px)", "line": ".95", "weight": 900, "font": "display", "case": "upper"}
  },
  "space": [0, 5, 8, 10, 12, 16, 18, 20, 24, 28, 32, 48, 56],
  "radius": {"sm": 13, "md": 16, "lg": 128, "pill": 999},
  "shadow": {
    "cta": "0 8px 28px color-mix(in srgb, var(--accent) 45%, transparent)",
    "burger": "drop-shadow(0 14px 30px rgba(0,0,0,.35))"
  },
  "motion": {"fast": "150ms", "ease": "ease"},
  "layout": {"max-width": 1024, "gutter": 16, "breakpoint-mobile": 720, "cta-min-height": 60, "hero-cols": "1.4fr 1fr", "grid-gap": 48, "menu-cols": 2}
}
